# Modelo de configuração. Copie para ".env" (nesta mesma pasta) e preencha.
# O arquivo .env NÃO vai para o git: ele fica só na máquina/servidor.

# Produção: 0 (desligado). No seu computador pode deixar sem esta linha (fica ligado).
DJANGO_DEBUG=0

# Chave secreta longa e aleatória. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Endereços pelos quais o site é acessado, separados por vírgula
DJANGO_ALLOWED_HOSTS=seuusuario.pythonanywhere.com

# Opcional: e-mail (Gmail com "senha de app") para recuperação de senha
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
